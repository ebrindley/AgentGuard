(version 1)
(allow default)
(define (h s) (string-append (param "HOME") s))

(deny file-write*)
(allow file-write*
  (subpath (h "/.local/share/opencode"))
  (subpath (h "/.local/state/opencode"))
  (subpath (h "/.cache"))
  (subpath (h "/Library/Caches"))
  (subpath (h "/.npm"))
  (subpath (h "/.bun/install/cache"))
  (subpath (h "/.cc-safety-net/logs"))
  (subpath "/private/tmp")
  (subpath (param "DARWIN_TEMP"))
  (subpath (param "DARWIN_CACHE"))
  (literal "/dev/null")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (literal "/dev/dtracehelper")
  (regex #"^/dev/ttys[0-9]+$")
  (subpath "/dev/fd"))

(if (string=? (param "GUI") "1")
  (allow file-write*
    (subpath (h "/Library/Application Support/ai.opencode.desktop"))
    (subpath (h "/Library/Saved Application State/ai.opencode.desktop.savedState"))))

;;@USER_RULES@

(deny file-write*
  (subpath (h "/Library/Application Support/OpenCodeGuard"))
  (subpath (h "/OpenCode Guard"))
  (subpath (h "/.config/opencode"))
  (subpath (h "/.opencode"))
  (subpath (h "/Library/LaunchAgents"))
  (subpath (h "/Applications/OpenCode Guard.app"))
  (literal (h "/.zshenv"))
  (literal (h "/.zprofile"))
  (literal (h "/.zshrc"))
  (literal (h "/.zlogin"))
  (literal (h "/.profile"))
  (literal (h "/.bash_profile"))
  (literal (h "/.bashrc"))
  (literal (param "HOME"))
  (literal (h "/Library"))
  (literal (h "/Library/Application Support"))
  (literal (h "/.config"))
  (literal (h "/Applications"))
  (regex #"/\.opencode(/|$)")
  (regex #"/opencode\.jsonc?$")
  (require-all (regex #"/\.cc-safety-net(/|$)") (require-not (subpath (h "/.cc-safety-net/logs")))))
(allow file-write* (regex #"/\.opencode/\.gitignore$"))

(deny lsopen)
(deny job-creation)
(deny process-exec
  (literal "/usr/bin/open")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/osacompile")
  (literal "/usr/bin/codesign")
  (literal "/usr/sbin/diskutil")
  (literal "/bin/launchctl")
  (literal "/usr/bin/sudo"))
