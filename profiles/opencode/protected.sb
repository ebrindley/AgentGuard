  (require-all (regex #"/\.opencode(/|$)") (require-not (skill-content)))
  (require-all (regex #"/(opencode|tui)\.jsonc?$") (require-not (skill-content)))
  (require-all (regex #"/\.cc-safety-net(/|$)") (require-not (skill-content)) (require-not (subpath (h "/.cc-safety-net/logs"))))
  (regex #"/\.opencode/skills?$")
