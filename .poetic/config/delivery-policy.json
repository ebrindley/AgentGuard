{
  "schemaVersion": 1,
  "profile": "fast",
  "repository": {
    "host": "github.com",
    "fullName": "ebrindley/AgentGuard"
  },
  "landingOwner": "native-host",
  "reviewTiming": "before-merge",
  "stages": {
    "gate": {
      "owner": "github-actions",
      "scope": "Core profiles, rulebook and macOS confinement",
      "githubActions": {
        "workflows": [".github/workflows/test.yml"],
        "selectedChecks": ["tests"],
        "events": ["pull_request", "workflow_dispatch"]
      }
    },
    "background": {
      "owner": "github-actions",
      "scope": "Full integration and migration matrix for code pushes and manual validation",
      "githubActions": {
        "workflows": [
          ".github/workflows/full.yml"
        ],
        "selectedChecks": [
          "suites (macos-15)",
          "suites (macos-26)",
          "migrate-pi (macos-15)",
          "migrate-pi (macos-26)"
        ],
        "events": [
          "push",
          "workflow_dispatch"
        ],
        "ref": "refs/heads/main"
      }
    }
  },
  "repair": {
    "enabled": false,
    "maxCandidateAttempts": 2
  }
}
