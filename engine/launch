#!/bin/zsh
# usage: launch cli|gui|profile|check [staged] [args...]
emulate -L zsh
setopt err_exit no_unset pipe_fail extended_glob

mode=${1:-}
log=
(( $# )) && shift

fail() {
  if [[ -n ${log:-} && -d ${log:h} ]]; then
    print -r -- "agent-guard-stage:${failure_stage:-initialization}" >> "$log" 2>/dev/null || true
  fi
  print -ru2 -- "agent-guard: $*"
  if [[ $mode == gui ]]; then
    /usr/bin/osascript -e 'on run argv' -e 'display alert "Agent Guard" message (item 1 of argv) as critical' -e 'end run' "$*" >/dev/null 2>&1 || true
  fi
  exit 1
}

# Resolve the account before reading any executable profile. No ambient override.
account_home() {
  local login record
  login=$(/usr/bin/id -un) || return 1
  [[ -n $login ]] || return 1
  record=$(/usr/bin/dscl /Search -read "/Users/$login" NFSHomeDirectory) || return 1
  case $record in
    ('NFSHomeDirectory: /'*) REPLY=${record#NFSHomeDirectory: } ;;
    ($'NFSHomeDirectory:\n /'*) REPLY=${record#$'NFSHomeDirectory:\n '} ;;
    (*) return 1 ;;
  esac
  [[ $REPLY == /* && $REPLY != / && $REPLY != *$'\n'* && -d $REPLY ]]
}
# END ACCOUNT LOOKUP
account_home || { print -ru2 'agent-guard: cannot resolve account home'; exit 1 }
home=${REPLY:A}
engine="$home/Library/Application Support/AgentGuard"
# Run only from a release folder directly inside the account-derived engine
# folder, whatever path was used to call this file. Checked before any source.
release=${0:A:h}
[[ ${release:h} == "$engine/releases" && ${release:t} == [0-9A-Za-z.+-]## && -f $release/RELEASE ]] ||
  fail "not an installed release: $release"
list_dir="$home/Agent Guard"
list="$list_dir/Guard List.txt"
log="$list_dir/last-launch-opencode.log"
here=$release
profile_dir="$release/profiles/opencode"
failure_stage=configuration

# check staged tests a release that is not current yet, without the steps that
# would publish its rules or create harness config.
staged=0
if [[ $mode == check && ${1:-} == staged ]]; then
  shift
  current="$engine/current"
  [[ $release != ${current:A} ]] || fail "check staged is for a release that is not current; run check"
  staged=1
fi

source "$profile_dir/harness.zsh"
source "$profile_dir/hooks.zsh"
source "$profile_dir/skills.zsh"
source "$profile_dir/runtime.zsh"

note() {
  print -r -- "$*" >> "$log"
  [[ $mode == (gui|check) ]] || print -ru2 -- "agent-guard: $*"
}
# The per-launch summary is recorded for the operator. Refusals and warnings
# stay on the terminal through note; failures use fail.
record() { print -r -- "$*" >> "$log" }

within() { [[ $2 == / || $1 == "$2" || $1 == "$2"/* ]] }

# Engine folders: Agent Guard's and OpenCode Guard's. A command that resolves
# into one of them starts a guard, not the harness; following it can loop.
guard_engines=("$engine" "$home/Library/Application Support/OpenCodeGuard")

in_guard() {
  local e
  for e in $guard_engines; do
    within "${1:A}" "${e:A}" && return 0
  done
  return 1
}

next_cli() {
  local d f cli
  for d in $path; do
    for cli in $cli_names; do
      f="$d/$cli"
      [[ -x $f && ! -d $f ]] && ! in_guard "$f" || continue
      REPLY=$f
      return 0
    done
  done
  for f in $cli_search; do
    [[ -x $f ]] && ! in_guard "$f" && { REPLY=$f; return 0 }
  done
  if find_app && [[ -x $REPLY/Contents/Resources/opencode-cli ]]; then
    REPLY="$REPLY/Contents/Resources/opencode-cli"
    return 0
  fi
  return 1
}

find_app() {
  local a
  for a in $app_paths \
           ${(f)"$(/usr/bin/mdfind "kMDItemCFBundleIdentifier == '$app_bundle_id'" 2>/dev/null)"}; do
    [[ -d $a/Contents/MacOS ]] && { REPLY=$a; return 0 }
  done
  return 1
}
[[ $mode == find-app ]] && { find_app && print -r -- "$REPLY"; exit }

# Apply in every mode, including nested launches and check. With no names,
# export would print the environment.
unset $env_unset
(( $#env_set )) && export $env_set
[[ ${CC_SAFETY_NET_LEVEL:-} == paranoid ]] || export CC_SAFETY_NET_LEVEL=strict

# The engine's nesting marker is exported just before exec. OpenCode Guard's
# marker also counts as already guarded until step 11. Without a marker, only
# the error macOS reports for applying a second profile shows another tool's
# sandbox (decision D10, docs/DESIGN.md section 15); a probe that fails for any
# other reason takes the normal path and fails there.
inside=
if ! probe=$(/usr/bin/sandbox-exec -p '(version 1)(allow default)' /usr/bin/true 2>&1); then
  if [[ ${AGENT_GUARD_SANDBOXED:-} == 1 || ${OPENCODE_SANDBOXED:-} == 1 ]]; then
    inside=guard
  elif [[ $probe == *'sandbox_apply: Operation not permitted'* ]]; then
    inside=other
  fi
fi
if [[ -n $inside ]]; then
  if [[ $inside == other ]]; then
    # Write nothing outside and set no marker: the existing sandbox decides what
    # may be written. The plugin's guard probe can fail under that sandbox too,
    # so AGENT_GUARD_OUTER_SANDBOX tells it the session is unguarded.
    log=
    note() { print -ru2 -- "agent-guard: $*" }
    export AGENT_GUARD_OUTER_SANDBOX=1
    [[ $mode == cli ]] || fail "already inside another sandbox, where Agent Guard cannot apply its own; open this outside that sandbox"
    print -ru2 -- "agent-guard: already inside another sandbox; Agent Guard's sandbox is not applied and OpenCode runs under the existing one"
  else
    [[ $mode == cli ]] || fail "already inside the guard; run this from Terminal, outside any guard or sandbox"
  fi
  next_cli || fail "opencode not found"
  cli=$REPLY
  sandbox=()
  # This branch already inherits the outer sandbox; a second Seatbelt profile
  # cannot be applied. The version probe must keep that inherited confinement.
  version=$("$cli" --version 2>/dev/null) || fail 'cannot read nested OpenCode version'
  if [[ $version == (opencode\ v2.*|2.*|v2.*) ]]; then
    managed=0
    opencode_cli_args "$@"
    (( ! managed )) || fail 'run this V2 command from Terminal outside the existing guard'
    set -- "${reply[@]}"
  fi
  exec "$cli" "$@"
fi
export HOME=$home
[[ -r $list ]] || fail "cannot read $list"
# State roots: the profile's state_hook resolves and canonicalizes them, or refuses.
typeset -aU cache_given cache_roots
$state_hook
cache_prefix="${cache_roots[1]%/}/"
# Installed harnesses (docs/DESIGN.md section 3, Every installed harness): the open
# transaction's candidate inventory, else the stamp's; either without harnesses is
# from before 0.2.0 and means OpenCode alone. With Pi installed, its recorded
# wrappers are the keys of state/wrappers.json; a key that does not match
# [A-Za-z0-9._-]+, or is . or .., is ignored. A record that exists but cannot be
# read, or does not hold exactly one JSON document, such as an empty file, refuses
# the launch, so the denies it adds are never dropped; a transaction that closes
# between the two reads leaves the stamp to read.
typeset -aU installed pi_wrappers
installed=(opencode)
one_doc='[inputs] | if length != 1 then error else .[0] end | '
for f in "$engine/state/txn/plan.json" "$engine/state/stamp.json"; do
  [[ -e $f || -L $f ]] || continue
  if out=$(/usr/bin/jq -rn "$one_doc"'if type != "object" then error elif has("harnesses") | not then "opencode"
      elif (.harnesses | type) == "array" and all(.harnesses[]; type == "string") then .harnesses[] else error end' "$f" 2>/dev/null); then
    installed=(${(f)out})
    break
  fi
  [[ ! -e $f && ! -L $f ]] || fail "cannot read the installed harnesses in $f"
done
f="$engine/state/wrappers.json"
if (( ${installed[(Ie)pi]} )) && [[ -e $f || -L $f ]]; then
  out=$(/usr/bin/jq -rn "$one_doc"'if type == "object" and (.wrappers | type) == "object" then .wrappers | keys[] else error end' "$f" 2>/dev/null) ||
    fail "cannot read Pi's recorded wrappers in $f"
  pi_wrappers=(${${(M)${(f)out}:#[A-Za-z0-9._-]##}:#(.|..)})
fi

# An entry's meaning must not depend on filesystem state a session can write:
# a quoted entry is taken literally, an unquoted one has its Finder escapes
# removed, and neither choice consults the disk. Every symlink the resolution
# passes through is reported in link_nodes so the caller can pin it.
normalize() {
  local p=$1 component target resolved=/ quoted=0 hops=0
  local -a parts
  if [[ $p == (\"*\"|\'*\') ]]; then p=${p[2,-2]}; quoted=1; fi
  if (( ! quoted )) && [[ $p == *\\* ]]; then p=${(Q)p}; fi
  [[ $p == '~' || $p == '~/'* ]] && p=$home${p#\~}
  [[ $p == /* ]] || return 1
  # Follow one link at a time, so every link on the way is recorded, and apply
  # .. to what is already resolved. Resolving a whole chain in one step would
  # leave the links inside it unrecorded and so replaceable.
  # Missing suffixes remain usable for DENY and READ ONLY entries.
  parts=("${(@s:/:)p}")
  while (( $#parts )); do
    component=$parts[1]
    shift parts
    case $component in
      (''|.) continue ;;
      (..) resolved=${resolved:h}; continue ;;
    esac
    target="${resolved%/}/$component"
    if [[ -L $target ]]; then link_nodes+=("$target"); fi
    # A dangling link keeps its own name, as the rules for a missing target say,
    # so it is recorded but not followed.
    if [[ -L $target && -e $target ]] && (( hops < 32 )); then
      (( ++hops ))
      component=$(/usr/bin/readlink -- "$target") || return 1
      # A relative target resolves against the link's own folder, which
      # resolved already names; an absolute one restarts from the root.
      [[ $component == /* ]] && resolved=/
      parts=("${(@s:/:)component}" "${(@)parts}")
      continue
    fi
    resolved=$target
  done
  REPLY=$resolved
}

print -r -- "Agent Guard $mode ${release:t} $(/bin/date '+%Y-%m-%d %H:%M:%S')" > "$log"

essential=(/ $home $home/Library $home/.config $home/.local $home/.cache
           /usr /bin /sbin /System /Library /private /dev /opt /Applications)
sensitive=($home/Library/Application\ Support $home/.config $home/.local)
typeset -a allow readonly deny scoped
typeset -aU link_nodes
section=
while IFS= read -r line || [[ -n $line ]]; do
  line=${${line%$'\r'}##[[:space:]]##}
  line=${line%%[[:space:]]##}
  [[ -z $line || $line == \#* ]] && continue
  case ${(U)line} in
    (ALLOW(|[[:space:]]#[-:]*)) section=allow; continue ;;
    (READ([[:space:]]##|-)ONLY(|[[:space:]]#[-:]*)) section=readonly; continue ;;
    (DENY(|[[:space:]]#[-:]*)) section=deny; continue ;;
  esac
  [[ -n $section ]] || continue
  [[ $line != *$'\t'* ]] || fail "Guard List path contains a tab; remove it: $line"
  normalize "$line" || { note "skipped, not a full path: $line"; continue }
  p=$REPLY
  if [[ $section != allow ]]; then
    for e in $essential; do
      within "$e" "$p" && { note "refused ${${section:u}/READONLY/READ ONLY}, OpenCode needs $e: $p"; continue 2 }
    done
  fi
  if [[ $section == deny ]]; then
    [[ -e $p ]] || note "warning: DENY entry does not exist, check the spelling: $p"
    deny+=("$p")
    continue
  fi
  if [[ $section == allow && ! -e $p ]]; then note "skipped, does not exist: $p"; continue; fi
  if [[ $section == allow ]]; then
    for e in $sensitive; do
      within "$e" "$p" && { note "refused ALLOW, too broad: $p"; continue 2 }
    done
    allow+=("$p")
  else
    readonly+=("$p")
  fi
  scoped+=("${(l:3::0:)${#${p//[^\/]/}}}"$'\t'"$section"$'\t'"$p")
done < "$list"

sbpl() { local s=${1//\\/\\\\}; REPLY="\"${s//\"/\\\"}\"" }
typeset -aU user_readonly skill_roots skill_pins skill_configs config_roots protected_targets pi_guard
user_readonly=($readonly)
(( ${installed[(Ie)pi]} )) && pi_guard=("$home"/.local/bin/{pi,omp,pi-sandbox.sb,pi-sandbox-preamble.zsh,pi-sandbox-guard-extension} "${(@)pi_wrappers/#/$home/.local/bin/}"
  "$home/.pi/agent/extensions/pi-sandbox-guard" "$home/.config/pi-sandbox-guard/executables.conf")
opencode_skill_globals
typeset -a rules
typeset -U pinned
# A link an entry resolves through decides what that entry covers, so replacing
# it would re-aim the operator's rule at the next launch. Pin each one.
pinned+=($link_nodes)
for entry in ${(o)scoped}; do
  kind=${${entry#*$'\t'}%%$'\t'*}
  p=${entry##*$'\t'}
  sbpl "$p"
  if [[ $kind == allow ]]; then
    rules+=("(allow file-write* (subpath $REPLY))")
    [[ -d $p ]] && pinned+=("$p")
  else
    rules+=("(deny file-write* (subpath $REPLY))")
  fi
done
for p in $deny; do
  sbpl "$p"
  rules+=("(deny file-read* file-write* (subpath $REPLY))")
  for s in $allow $readonly; do
    within "$s" "$p" && note "overridden by DENY $p: $s"
  done
done

# Pi's and OMP's project config names, once Pi is installed (docs/DESIGN.md
# section 12, step 7f): Pi loads a trusted project's .pi, and OMP loads .omp from
# the project and its parents without asking, so a session that writes either
# plants code for the next Pi or OMP start. Both are write-denied anywhere in the
# final deny block, and a link at either name in the launch folder has its target
# write-denied, as OpenCode's own names do.
typeset -a pi_names
(( ${installed[(Ie)pi]} )) && pi_names=(.pi .omp)
protected=("$engine" "$list_dir" $protected
           $home/Library/LaunchAgents $home/.{zshenv,zprofile,zshrc,zlogin,profile,bash_profile,bash_login,bashrc}
           "${(@)protected_names/#/$PWD/}" "${(@)pi_names/#/$PWD/}")
for p in $protected; do
  target=${p:A}
  [[ -e $p && $target != "$p" ]] || continue
  sbpl "$target"
  rules+=("(deny file-write* (subpath $REPLY))")
  protected_targets+=("$target")
done
for p in $deny $readonly $protected_targets; do
  a=${p:h}
  while [[ $a != / ]]; do pinned+=("$a"); a=${a:h}; done
done
for p in $pinned; do sbpl "$p"; rules+=("(deny file-write* (literal $REPLY))"); done

sbpl_path() { if [[ $1 == "$home"/* ]]; then sbpl "${1#$home}"; REPLY="(h $REPLY)"; else sbpl "$1"; fi }
typeset -aU state_rules state_pins
pin_above() { local a=${1:h}; while [[ $a != / && $a != "$home" ]]; do state_pins+=("$a"); a=${a:h}; done }
# The default cache is an automatic grant; its entry must not be redirected by
# a session and interpreted as a different grant at the next launch.
p="$home/.cache"
for q in "$p" "${p:A}"; do state_pins+=("$q"); pin_above "$q"; done
# Pi's guard files, once Pi is installed (docs/DESIGN.md section 11, What changes
# for OpenCode sessions): the launchers, profile, preamble and recorded wrappers,
# which run outside the sandbox at the next Pi start, the extension folder and the
# bindings, and pi-sandbox-guard-extension, the extension folder the launcher loads
# instead when it exists beside it; that one is usually absent and must stay so.
# Each is denied as named, with its folder resolved, and at its target.
# Each folder on the way from home, as named, and the folders above each of those
# and above the target are pinned, so no link on the way can be moved or removed.
typeset -aU pi_guard
(( ${installed[(Ie)pi]} )) &&
  pi_guard=("$home"/.local/bin/{pi,omp,pi-sandbox.sb,pi-sandbox-preamble.zsh,pi-sandbox-guard-extension} "${(@)pi_wrappers/#/$home/.local/bin/}"
            "$home/.pi/agent/extensions/pi-sandbox-guard" "$home/.config/pi-sandbox-guard/executables.conf")
for p in $protected_paths $pi_guard; do
  for q in "$p" "${${p:h:A}%/}/${p:t}" "${p:A}"; do protected_targets+=("$q"); sbpl_path "$q"; state_rules+=("  (subpath $REPLY)"); pin_above "$q"; done
  a=${p:h}
  while [[ $a != / && $a != "$home" ]]; do
    q="${${a:h:A}%/}/${a:t}"
    state_pins+=("$q")
    pin_above "$q"
    a=${a:h}
  done
done
(( $#pi_names )) && state_rules+=('  (regex #"/\.pi(/|$)")' '  (regex #"/\.omp(/|$)")')
typeset -aU frozen_pins
frozen_pins=($state_pins $skill_pins)
for p in $frozen_pins; do sbpl_path "$p"; state_rules+=("  (literal $REPLY)"); done

[[ -n ${XDG_CONFIG_HOME:-} && $XDG_CONFIG_HOME != "$home/.config" ]] && note "custom XDG config follows Guard List permissions; the default guard plugin may not load"
[[ -n ${OPENCODE_CONFIG:-} || -n ${OPENCODE_CONFIG_DIR:-} || -n ${OPENCODE_TUI_CONFIG:-} ]] && note "custom OpenCode config paths receive no automatic write grant"
[[ ${OPENCODE_PURE:-} == 1 ]] && note "OpenCode plugin-disabled mode: Seatbelt remains active; advisory plugin loading is not assured"
record "allow: ${(j:, :)allow:-none}"
record "read only: ${(j:, :)readonly:-none}"
record "deny: ${(j:, :)deny:-none}"
record "always writable for OpenCode itself: ~/.local/share/opencode, ~/.local/state/opencode, ~/.cache, ~/Library/Caches, ~/.npm, ~/.bun/install/cache, /private/tmp, per-user temp and cache"
cache_dirs=(${^cache_roots}/opencode)
record "OpenCode cache follows filesystem permissions: ${(j:, :)cache_dirs}"
(( $#pi_guard )) && record "write-protected for Pi, maintained outside the guard: ${(j:, :)pi_guard}"
(( $#pi_names )) && record "write-protected anywhere, Pi's and OMP's project config: ${(j:, :)pi_names}"

profile=$(<"$here/profile.sb")
profile=${profile/';;@PEER_RUNTIME@'/$(<"$here/peer-runtime.sb")}
profile=${profile/';;@USER_RULES@'/${(F)rules}}
# Keep 1.0.3 rule order and SBPL spelling while moving harness paths to data.
path_rules() {
  local p indent=$1
  shift
  for p in "$@"; do
    sbpl "${p#$home}"
    if [[ $p == "$home"/* ]]; then print -r -- "$indent(subpath (h $REPLY))"; else sbpl "$p"; print -r -- "$indent(subpath $REPLY)"; fi
  done
}
profile=${profile/';;@WRITABLE@'/$(path_rules '  ' $writable $skill_roots $config_roots)}
profile=${profile/';;@WRITABLE_GUI@'/$(path_rules '    ' $writable_gui)}
skill_content() {
  local p
  print -r -- '(define (skill-content) (require-any'
  print -r -- '  (regex #"/\.opencode/skills?/[^/]+")'
  print -r -- '  (regex #"/\.(agents|claude)/skills/[^/]+")'
  for p in $skill_roots; do sbpl_path "$p"; print -r -- "  (require-all (subpath $REPLY) (require-not (literal $REPLY)))"; done
  for p in ${^skill_configs}/{skill,skills}; do (( ${skill_roots[(Ie)$p]} )) && continue; sbpl_path "$p"; print -r -- "  (require-all (subpath $REPLY) (require-not (literal $REPLY)))"; done
  print -r -- '))'
}
profile=${profile/';;@SKILL_CONTENT@'/$(skill_content)}
profile=${profile/';;@STATE_PROTECTED@'/${(F)state_rules}}
profile=${profile/';;@PROTECTED_NAMES@'/$(<"$profile_dir/$protected_fragment")}
darwin_temp=${$(/usr/bin/getconf DARWIN_USER_TEMP_DIR):A}
darwin_cache=${$(/usr/bin/getconf DARWIN_USER_CACHE_DIR):A}

/bin/mkdir -p $writable
[[ $mode == gui ]] && /bin/mkdir -p "$writable_gui[1]"

jarr() { /usr/bin/jq -cn '$ARGS.positional' --args "$@" }
/bin/mkdir -p "$engine/state"
/bin/mkdir -p "$engine/state/opencode"
session=$(/usr/bin/mktemp -d "$engine/state/opencode/${release:t}.XXXXXXXX")
# The folder belongs to this process: exec keeps the pid and start time, and
# the managed desktop launch stays alive until the app exits. Pruning reads
# this record.
owner_start=$(/bin/ps -o lstart= -p $$ 2>/dev/null) || owner_start=
[[ -z $owner_start ]] || print -r -- "$$"$'\n'"${(j: :)${=owner_start}}" > "$session/owner"
# No process outlives a staged check, and a snapshot left behind would keep a
# failed install from removing the new engine folder.
if (( staged )); then
  trap '/bin/rm -rf -- "$session"; /bin/rmdir -- "$engine/state/opencode" 2>/dev/null || true' EXIT
fi
channel= replies=
failure_stage=checker-preparation preparation_status=ready
opencode_checker_snapshot "$session" || fail "cannot preserve the checker policy in $session"
context="$session/permissions.json"
/usr/bin/jq -n --argjson allow "$(jarr $allow)" --argjson readonly "$(jarr $user_readonly)" \
  --argjson deny "$(jarr $deny)" --argjson protected "$(jarr $protected_targets)" \
  --argjson skills "$(jarr $skill_roots)" --argjson configs "$(jarr $skill_configs)" \
  --argjson writable "$(jarr $writable $darwin_cache $config_roots)" \
  --argjson pins "$(jarr $pinned $state_pins $skill_pins)" \
  --arg checker "$session/checker" --arg preparation "$channel" --arg preparationReplies "$replies" --arg preparationStatus "$preparation_status" \
  '{allow:$allow,readonly:$readonly,deny:$deny,protected:$protected,skills:$skills,configs:$configs,writable:$writable,pins:$pins,checker:$checker,preparation:$preparation,preparationReplies:$preparationReplies,preparationStatus:$preparationStatus}' > "$context"
export AGENT_GUARD_CONTEXT="$context"
if (( ! staged )); then
  /bin/cp "$context" "$engine/state/rules.json.$$"
  /bin/mv -f "$engine/state/rules.json.$$" "$engine/state/rules.json"
fi

sandbox=(/usr/bin/sandbox-exec -D "HOME=$home" -D "DARWIN_TEMP=$darwin_temp" -D "DARWIN_CACHE=$darwin_cache" -p "$profile")
managed=0 managed_cli=

case $mode in
  (cli)
    failure_stage=host-launch
    attached=0
    [[ ${1:-} == attach ]] && attached=1
    for arg in "$@"; do
      [[ $arg == -- ]] && break
      [[ $arg == --attach || $arg == --attach=* ]] && attached=1
    done
    (( attached )) && note "attached client is sandboxed; the server executes tools under its own permissions"
    next_cli || fail "opencode not found"
    cli=$REPLY
    opencode_major "$cli"
    if [[ $REPLY == 2 ]]; then
      opencode_cli_args "$@"
      set -- "${reply[@]}"
      (( ! managed )) || managed_cli=$cli
    fi
    set -- -D GUI=0 "$cli" "$@"
    ;;
  (gui)
    failure_stage=host-launch
    find_app || fail "OpenCode.app not found"
    app=$REPLY
    main=$(/usr/bin/plutil -extract CFBundleExecutable raw "$app/Contents/Info.plist")
    /usr/bin/pgrep -x "$main" >/dev/null && fail "OpenCode is already open. If you opened it from Agent Guard, click OpenCode in the Dock to show its window. Otherwise quit OpenCode, then open Agent Guard."
    if [[ -x $app/Contents/Resources/opencode-cli ]]; then
      cli="$app/Contents/Resources/opencode-cli"
      opencode_major "$cli"
      if [[ $REPLY == 2 ]]; then managed=1 managed_cli=$cli; fi
    fi
    set -- -D GUI=1 "$app/Contents/MacOS/$main" $gui_args "$@"
    ;;
  (profile)
    print -r -- "$profile"
    exit 0
    ;;
  (check)
    probe="$engine/state/.check" tmp="$darwin_temp/.agent-guard-check" ok=1 rc=0
    $sandbox -D GUI=0 /usr/bin/touch "$probe" 2>/dev/null && { print "FAIL protected write allowed"; ok=0 } || print "ok   protected write denied"
    $sandbox -D GUI=0 /usr/bin/touch "$tmp" && print "ok   temp write allowed" || { print "FAIL temp write denied"; ok=0 }
    $sandbox -D GUI=0 /usr/bin/open -h >/dev/null 2>&1 || rc=$?
    (( rc == 71 )) && print "ok   open denied" || { print "FAIL open allowed"; ok=0 }
    /bin/rm -f "$probe" "$tmp"
    $check_hook
    (( ok ))
    exit
    ;;
  (*) fail "usage: launch cli|gui|profile|check [staged]" ;;
esac

# Session folders of ended launches. Pruning runs here, outside the sandbox and
# in the background so it never delays or fails a launch, when the stamp is more
# than a day old. A folder with an owner record goes when the owner is gone and
# the folder is a day old; one without goes when it predates the last boot.
prune_sessions() {
  local d rec start boot now mtime
  setopt no_err_exit
  zmodload zsh/datetime zsh/stat 2>/dev/null || return 0
  boot=$(/usr/sbin/sysctl -n kern.boottime 2>/dev/null) || return 0
  boot=${${boot#*sec = }%%,*}
  [[ $boot == <-> ]] || return 0
  now=$EPOCHSECONDS
  for d in "$engine/state/opencode"/*.????????(N); do
    [[ -d $d && ! -L $d && $d != "$session" ]] || continue
    zstat -A mtime +mtime -- "$d" 2>/dev/null || continue
    rec=()
    [[ -f $d/owner ]] && rec=("${(@f)$(<"$d/owner" 2>/dev/null)}")
    if [[ ${rec[1]:-} == <-> && -n ${rec[2]:-} ]]; then
      start=$(/bin/ps -o lstart= -p $rec[1] 2>/dev/null)
      [[ ${(j: :)${=start}} == "$rec[2]" ]] && continue
      (( now - mtime > 86400 )) || continue
    else
      (( mtime < boot )) || continue
    fi
    /bin/rm -rf -- "$d"
  done
}
recent=("$engine/state"/.session-prune(Nmh-24))
if (( ! $#recent )); then
  { : > "$engine/state/.session-prune" } 2>/dev/null || true
  (prune_sessions) >/dev/null 2>&1 </dev/null &!
fi

# The plugin loads through current, which an update can move; AGENT_GUARD_RELEASE
# tells it to use this release.
export AGENT_GUARD_SANDBOXED=1 AGENT_GUARD_RELEASE=${release:t}
unset AGENT_GUARD_OUTER_SANDBOX
export AGENT_GUARD_PEER_PATH=${AGENT_GUARD_PEER_PATH:-$PATH}
path=("$release/peers" $path)
(( ! managed )) || opencode_managed "$managed_cli" "$@"
exec $sandbox "$@"
